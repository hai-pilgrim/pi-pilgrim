#!/usr/bin/env node
/**
 * PIlgrim - A customized harness for the pi coding agent
 *
 * Usage: pilgrim [options] [prompt]
 *        npx pilgrim [options] [prompt]
 */

import { spawn } from "node:child_process";
import { dirname, join } from "node:path";
import { fileURLToPath } from "node:url";

const __dirname = dirname(fileURLToPath(import.meta.url));
const root = join(__dirname, "..");
const extensionPath = join(root, "src", "extensions", "index.ts");

const args = process.argv.slice(2);

// Build pi command with our extension pre-loaded
const piArgs = ["pi", "--extension", extensionPath, ...args];

// Run pi directly via npx
const child = spawn("npx", piArgs, {
	stdio: "inherit",
	cwd: process.cwd(),
	env: process.env,
});

child.on("exit", (code) => {
	process.exit(code ?? 0);
});
